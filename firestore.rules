rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =============================================================
    // Identidade e acesso por fazenda
    // =============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function hasUserProfile() {
      return isAuthenticated() && exists(userPath());
    }

    function getUserData() {
      return get(userPath()).data;
    }

    function getUserRole() {
      return hasUserProfile() ? getUserData().role : null;
    }

    function getUserFarmId() {
      return hasUserProfile() ? getUserData().farmId : null;
    }

    function isSystemAdmin() {
      return getUserRole() == 'system_admin';
    }

    function isFarmOwner(farmId) {
      return isAuthenticated()
        && farmId is string
        && exists(/databases/$(database)/documents/fazendas/$(farmId))
        && get(/databases/$(database)/documents/fazendas/$(farmId)).data.producerId
          == request.auth.uid;
    }

    function isAssignedToFarm(farmId) {
      return hasUserProfile()
        && farmId is string
        && getUserFarmId() == farmId;
    }

    function hasFarmAccess(farmId) {
      return isSystemAdmin()
        || isFarmOwner(farmId)
        || isAssignedToFarm(farmId);
    }

    function isFarmManager(farmId) {
      return isSystemAdmin()
        || isFarmOwner(farmId)
        || (
          isAssignedToFarm(farmId)
          && getUserRole() in ['admin', 'produtor', 'gerente']
        );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function keepsFarmId() {
      return incoming().farmId == existing().farmId;
    }

    function isAllowedInviteRole(role) {
      return role in ['gerente', 'colaborador', 'operador'];
    }

    // =============================================================
    // Usuários e convites
    // =============================================================
    function isInitialOwnerProfile(userId) {
      return request.auth.uid == userId
        && incoming().id == userId
        && incoming().role in ['admin', 'produtor']
        && !('farmId' in incoming())
        && !('conviteId' in incoming());
    }

    function isValidInvitedProfile(userId) {
      return request.auth.uid == userId
        && incoming().id == userId
        && incoming().conviteId is string
        && exists(
          /databases/$(database)/documents/convites/$(incoming().conviteId)
        )
        && get(
          /databases/$(database)/documents/convites/$(incoming().conviteId)
        ).data.token == incoming().conviteId
        && get(
          /databases/$(database)/documents/convites/$(incoming().conviteId)
        ).data.used == false
        && get(
          /databases/$(database)/documents/convites/$(incoming().conviteId)
        ).data.expiresAt > request.time
        && get(
          /databases/$(database)/documents/convites/$(incoming().conviteId)
        ).data.farmId == incoming().farmId
        && get(
          /databases/$(database)/documents/convites/$(incoming().conviteId)
        ).data.role == incoming().role
        && isAllowedInviteRole(incoming().role);
    }

    function isInviteAcceptance(conviteId) {
      return existing().token == conviteId
        && existing().used == false
        && existing().expiresAt > request.time
        && incoming().diff(existing()).affectedKeys()
          .hasOnly(['used', 'usedBy', 'usedAt'])
        && incoming().used == true
        && incoming().usedBy == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.conviteId == conviteId
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.farmId == existing().farmId
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.role == existing().role;
    }

    match /usuarios/{userId} {
      allow get: if isAuthenticated() && (
        request.auth.uid == userId
        || isSystemAdmin()
        || (
          resource.data.farmId is string
          && isFarmManager(resource.data.farmId)
        )
      );

      allow list: if isAuthenticated() && (
        isSystemAdmin()
        || (
          resource.data.farmId is string
          && isFarmManager(resource.data.farmId)
        )
      );

      allow create: if isAuthenticated()
        && (
          isInitialOwnerProfile(userId)
          || isValidInvitedProfile(userId)
        );

      allow update: if isAuthenticated() && (
        isSystemAdmin()
        || (
          request.auth.uid == userId
          && incoming().diff(existing()).affectedKeys()
            .hasOnly(['primaryFarmId', 'nome', 'email', 'updatedAt'])
        )
      );

      allow delete: if isAuthenticated() && isSystemAdmin();
    }

    match /convites/{conviteId} {
      allow get: if isAuthenticated() && (
        isFarmManager(resource.data.farmId)
        || (
          resource.data.token == conviteId
          && resource.data.used == false
          && resource.data.expiresAt > request.time
        )
      );

      allow list: if isAuthenticated()
        && isFarmManager(resource.data.farmId);

      allow create: if isAuthenticated()
        && conviteId == incoming().token
        && incoming().createdBy == request.auth.uid
        && incoming().used == false
        && incoming().expiresAt > request.time
        && isAllowedInviteRole(incoming().role)
        && isFarmManager(incoming().farmId);

      allow update: if isAuthenticated()
        && isInviteAcceptance(conviteId);

      allow delete: if isAuthenticated()
        && isFarmManager(existing().farmId);
    }

    // =============================================================
    // Fazenda
    // =============================================================
    match /fazendas/{farmId} {
      allow read: if isAuthenticated() && (
        isSystemAdmin()
        || resource.data.producerId == request.auth.uid
        || getUserFarmId() == farmId
      );

      allow create: if isAuthenticated()
        && incoming().producerId == request.auth.uid
        && incoming().id == farmId;

      allow update: if isAuthenticated()
        && (
          isSystemAdmin()
          || resource.data.producerId == request.auth.uid
        )
        && incoming().producerId == existing().producerId;

      allow delete: if isAuthenticated() && (
        isSystemAdmin()
        || resource.data.producerId == request.auth.uid
      );
    }

    // =============================================================
    // Operação de campo
    // =============================================================
    match /ordens_servico/{ordemId} {
      allow read: if isAuthenticated()
        && hasFarmAccess(existing().farmId);

      allow create: if isAuthenticated()
        && isFarmManager(incoming().farmId);

      allow update: if isAuthenticated()
        && hasFarmAccess(existing().farmId)
        && keepsFarmId()
        && (
          isFarmManager(existing().farmId)
          || incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        );

      allow delete: if isAuthenticated()
        && isFarmManager(existing().farmId);
    }

    match /execucoes_servico/{execucaoId} {
      allow read: if isAuthenticated()
        && hasFarmAccess(existing().farmId);

      allow create: if isAuthenticated()
        && hasFarmAccess(incoming().farmId)
        && (
          isFarmManager(incoming().farmId)
          || incoming().operadorId == request.auth.uid
          || incoming().userId == request.auth.uid
        );

      allow update: if isAuthenticated()
        && hasFarmAccess(existing().farmId)
        && keepsFarmId()
        && (
          isFarmManager(existing().farmId)
          || existing().operadorId == request.auth.uid
          || existing().userId == request.auth.uid
        );

      allow delete: if isAuthenticated()
        && isFarmManager(existing().farmId);
    }

    match /segmentos_execucao/{segmentoId} {
      allow read: if isAuthenticated()
        && hasFarmAccess(existing().farmId);

      allow create: if isAuthenticated()
        && hasFarmAccess(incoming().farmId);

      allow update, delete: if isAuthenticated()
        && hasFarmAccess(existing().farmId)
        && (
          isFarmManager(existing().farmId)
          || existing().operadorId == request.auth.uid
        );
    }

    match /notificacoes_operacionais/{notificacaoId} {
      allow read: if isAuthenticated()
        && hasFarmAccess(existing().farmId);

      allow create: if isAuthenticated()
        && hasFarmAccess(incoming().farmId);

      allow update: if isAuthenticated()
        && hasFarmAccess(existing().farmId)
        && incoming().diff(existing()).affectedKeys()
          .hasOnly(['visualizada']);

      allow delete: if isAuthenticated()
        && isFarmManager(existing().farmId);
    }

    function isOperationalCollection(collectionName) {
      return collectionName in [
        'pluviometros',
        'chuvas_comunitarias',
        'registros_pessoais',
        'checklist_respostas',
        'horimetros',
        'abastecimentos',
        'indicadores_consumo',
        'produtos',
        'equipamentos',
        'pecas_manutencao',
        'estoque',
        'movimentacoes_estoque',
        'planos_manutencao',
        'manutencoes_executadas',
        'registros_chuva'
      ];
    }

    match /{collectionName}/{documentId} {
      allow read: if isOperationalCollection(collectionName)
        && isAuthenticated()
        && hasFarmAccess(existing().farmId);

      allow create: if isOperationalCollection(collectionName)
        && isAuthenticated()
        && hasFarmAccess(incoming().farmId);

      allow update: if isOperationalCollection(collectionName)
        && isAuthenticated()
        && hasFarmAccess(existing().farmId)
        && keepsFarmId();

      allow delete: if isOperationalCollection(collectionName)
        && isAuthenticated()
        && (
          isFarmManager(existing().farmId)
          || existing().userId == request.auth.uid
        );
    }

    function isManagedCollection(collectionName) {
      return collectionName in [
        'talhoes',
        'ueis',
        'checklist_templates',
        'config_operacao_produtos',
        'ordens_programadas',
        'planejamentos_safra'
      ];
    }

    match /{collectionName}/{documentId} {
      allow read: if isManagedCollection(collectionName)
        && isAuthenticated()
        && hasFarmAccess(existing().farmId);

      allow create: if isManagedCollection(collectionName)
        && isAuthenticated()
        && isFarmManager(incoming().farmId);

      allow update: if isManagedCollection(collectionName)
        && isAuthenticated()
        && isFarmManager(existing().farmId)
        && keepsFarmId();

      allow delete: if isManagedCollection(collectionName)
        && isAuthenticated()
        && isFarmManager(existing().farmId);
    }

    // =============================================================
    // Núcleo agronômico e motores avançados
    // =============================================================
    function isAgronomicCollection(collectionName) {
      return collectionName in [
        'gdas',
        'memorias_agronomicas',
        'eventos_agronomicos',
        'timeline_agronomica',
        'aprendizados_agronomicos',
        'conhecimentos_agronomicos',
        'recomendacoes_agronomicas',
        'resultados_estatisticos',
        'processamentos_agronomicos',
        'auditorias_processamento_agronomico',
        'ciclosAgronomicos',
        'memoriasAgronomicas',
        'planosManejo',
        'decisoesAgronomicas',
        'eventosAgronomicos',
        'resultadosAgronomicos',
        'chuvasAgronomicas',
        'analisesSolo',
        'operacoesAgronomicas',
        'produtividadesAgronomicas',
        'registrosEconomicosAgronomicos',
        'indicesAgronomicos',
        'relacoesAgronomicas',
        'aprendizadosAgronomicos',
        'recomendacoesAgronomicas'
      ];
    }

    match /{collectionName}/{documentId} {
      allow read: if isAgronomicCollection(collectionName)
        && isAuthenticated()
        && hasFarmAccess(existing().farmId);

      allow create: if isAgronomicCollection(collectionName)
        && isAuthenticated()
        && hasFarmAccess(incoming().farmId);

      allow update: if isAgronomicCollection(collectionName)
        && isAuthenticated()
        && hasFarmAccess(existing().farmId)
        && keepsFarmId();

      allow delete: if isAgronomicCollection(collectionName)
        && isAuthenticated()
        && isFarmManager(existing().farmId);
    }

    match /resultados_cientificos/{resultadoId} {
      allow read: if isAuthenticated()
        && hasFarmAccess(existing().eventoCientifico.farmId);

      allow create: if isAuthenticated()
        && hasFarmAccess(incoming().eventoCientifico.farmId);

      allow update: if isAuthenticated()
        && hasFarmAccess(existing().eventoCientifico.farmId)
        && incoming().eventoCientifico.farmId
          == existing().eventoCientifico.farmId;

      allow delete: if isAuthenticated()
        && isFarmManager(existing().eventoCientifico.farmId);
    }

    match /templatesPlanoManejo/{templateId} {
      allow read: if isAuthenticated() && (
        isSystemAdmin()
        || existing().producerId == request.auth.uid
        || hasFarmAccess(existing().farmId)
      );

      allow create: if isAuthenticated() && (
        incoming().producerId == request.auth.uid
        || isFarmManager(incoming().farmId)
      );

      allow update: if isAuthenticated()
        && incoming().producerId == existing().producerId
        && (
          isSystemAdmin()
          || existing().producerId == request.auth.uid
          || isFarmManager(existing().farmId)
        );

      allow delete: if isAuthenticated() && (
        isSystemAdmin()
        || existing().producerId == request.auth.uid
        || isFarmManager(existing().farmId)
      );
    }

    match /logs_admin/{logId} {
      allow read, create: if isAuthenticated() && isSystemAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}